# Copy to .env and adjust. No secrets are committed; leave AEGIS_API_KEY empty for local development.
# Database: SQLite by default (zero setup). PostgreSQL example (install `pip install -e "backend[postgres]"`):
# AEGIS_DATABASE_URL=postgresql+psycopg2://aegis:CHANGE_ME@localhost:5432/aegis
AEGIS_DATABASE_URL=sqlite:///./data/aegis.db
AEGIS_ARTIFACT_DIR=./artifacts
AEGIS_DATA_DIR=./data
# If set, every API call (except /api/health) must send header X-API-Key. Local-development control only.
AEGIS_API_KEY=
AEGIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AEGIS_MAX_UPLOAD_MB=50
AEGIS_GRAPH_MAX_NODES=400
AEGIS_GRAPH_MAX_EDGES=1500
AEGIS_QUERY_TIMEOUT_S=10
# Reference amount for the structuring-like detector (an analytical parameter, not a regulatory threshold)
AEGIS_STRUCTURING_THRESHOLD=50000
# Frontend dev proxy target (frontend/.env.local)
VITE_API_TARGET=http://127.0.0.1:8000
# POSTGRES_PASSWORD is read by docker-compose for the optional postgres profile
POSTGRES_PASSWORD=change_me_locally
